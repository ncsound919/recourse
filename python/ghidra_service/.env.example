# Recourse Ghidra sidecar
GHIDRA_PORT=8510

# Path to a Ghidra install whose support/ contains analyzeHeadless[.bat].
# Leave unset to let the service auto-detect common install locations.
# GHIDRA_HOME=C:\ghidra_11.2.1_PUBLIC

# Java runtime used by Ghidra (JDK 17+). Auto-detected from JAVA_HOME/PATH.
# JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-21.0.4.7-hotspot

# Max heap for the headless analyzer JVM.
GHIDRA_HEADLESS_MAXMEM=2G

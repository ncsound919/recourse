# Recourse KG sidecar (NetworkX compute service). Start it with:
#   uvicorn main:app --host 127.0.0.1 --port 8500
# It is stateless: Recourse sends the graph in each request, the sidecar returns metrics.
# NOTE: 8500 is the default the TS client expects (KG_SIDECAR_URL). Keep them in sync.
KG_PORT=8500

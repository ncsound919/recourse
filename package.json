{
  "name": "recourse",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests api server.ts mcp-server.ts",
    "self-improve": "tsx scripts/nightly-self-improvement.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.38.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.12",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "fast-check": "^3.23.2",
    "helmet": "^8.3.0",
    "isolated-vm": "^7.0.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "oxlint": "^1.81.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vercel/node": "^12.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.11"
  }
}

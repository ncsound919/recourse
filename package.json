{
  "name": "recourse",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx --no-node-snapshot server.ts",
    "build": "vite build && node esbuild.config.mjs",
    "start": "node --no-node-snapshot dist/server.cjs",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('server.js',{force:true});\"",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests api server.ts mcp-server.ts",
    "orphan-check": "tsx scripts/orphan-check.mts",
    "self-improve": "tsx scripts/nightly-self-improvement.ts",
    "pipelines:bench": "tsx scripts/pipeline-benchmark.ts",
    "ecos:propose": "tsx scripts/ecos-propose.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "kaggle:smoke": "tsx scripts/kaggle-smoke.ts",
    "progressions:generate": "tsx scripts/generate-chord-progressions.ts",
    "audit": "tsx scripts/autopilot-cron.ts --all",
    "audit:one": "tsx scripts/autopilot-cron.ts --business",
    "audit:dry-run": "tsx scripts/autopilot-cron.ts --all --dry-run"
  },
  "dependencies": {
    "@e2b/code-interpreter": "^2.8.0",
    "@lancedb/lancedb": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@stdlib/math-base-special-riemann-zeta": "^0.3.1",
    "@stdlib/stats-padjust": "^0.2.3",
    "apache-arrow": "^18.1.0",
    "autograd-ts": "^0.1.5",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "diff-grok": "^1.4.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.2",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "fast-check": "^3.23.2",
    "helmet": "^8.3.0",
    "isolated-vm": "^7.0.1",
    "jsqubits": "^2.1.2",
    "jstat": "^1.9.6",
    "langfuse": "^3.39.2",
    "lucide-react": "^0.577.0",
    "mathjs": "^15.2.0",
    "motion": "^12.23.24",
    "node-cron": "^4.6.0",
    "oxlint": "^1.87.0",
    "prime-lib": "^0.5.0",
    "prom-client": "^15.1.3",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "tree-sitter": "^0.25.1",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.4",
    "@types/three": "^0.175.0",
    "@vercel/node": "^12.0.3",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.6.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^6.2.3",
    "vitest": "^4.1.11"
  }
}

# Model provider: any OpenAI-compatible endpoint. Generation runs local-first
# against the local MiniCPM5 model (llama-server) with an automatic fallback to the
# remote API profile. All generative features (evolve, mutate, dream, forge,
# swarm) route here. When the endpoint is unreachable the app reports OFFLINE -
# it never fabricates responses or canned text.

# API provider (OpenAI-compatible /v1). Phoenix Grove default:
# API_MODEL_BASE_URL="https://api.pgsgrove.com/v1"
# API_MODEL_NAME="deepseek-v4-flash-0731"
# API_MODEL_API_KEY=""
# Fallback legacy names (still honored):
MODEL_BASE_URL="https://api.pgsgrove.com/v1"
MODEL_API_KEY=""
MODEL_NAME="deepseek-v4-flash-0731"
# Request timeout for model calls, in milliseconds.
MODEL_TIMEOUT_MS="60000"

# Local OpenAI-compatible profile (non-agentic generation). Used LOCAL-FIRST
# with an automatic API fallback by the generation policy
# (pickGenerationProfile) — dream, mutation, forge, hypotheses, chat, reports.
# Agentic codegen (tool loop / project loop / compiler) does NOT use this; it
# goes through the harness LLM / LiteLLM and is unaffected.
#
# Preset: MiniCPM5-2B served by llama.cpp's llama-server, with tool-call
# reliability and CPU speed enabled (see start-local.ps1):
#   1) llama-server -m <path>\MiniCPM5-2B-Q4_K_M.gguf --host 127.0.0.1 \
#        --port 11434 -c 8192 --alias minicpm5-2b --jinja \
#        --spec-type ngram-mod --spec-ngram-mod-n-match 24
#      (--jinja enables native tool templates + schema-constrained arguments;
#       --spec-type ngram-mod is a draftless CPU speedup. Keep KV at q8_0 —
#       aggressive KV quant degrades tool calling.)
#   2) set the vars below; generation defaults to the local model.
# LOCAL_MODEL_BASE_URL="http://127.0.0.1:11434/v1"
# LOCAL_MODEL_NAME="minicpm5-2b"
# LOCAL_MODEL_API_KEY="local"
# Generation routing: 'auto' (default) = local-first w/ API fallback; 'local'
# or 'api' force one endpoint. LOCAL_AUTO_MAX_CHARS guards CPU prefill cost.
# RECOURSE_GENERATION_PROFILE="auto"
# LOCAL_AUTO_MAX_CHARS="12000"

# --- Model-native tool calling (local model / any OpenAI-compatible endpoint) ---
# The agent loop exposes the model's OpenAI `tools`: sandboxed self-hosted
# tools, read-only host operations, and the Recourse MCP server's tool set.
# Routes: GET /api/recourse/agent/tools (list), POST /api/recourse/agent/tools.
# Maximum model turns per run before the loop stops (default 4):
# AGENT_TOOLS_MAX_TURNS="4"
# Tools exposed per turn. Small models degrade past ~15-20 tools and collapse
# past ~50, so the loop retrieves a task-relevant shortlist instead:
# AGENT_TOOLS_MAX_PER_TURN="8"
# Include the agent_search_tools meta-tool so the model can pull more tools:
# AGENT_TOOLS_SEARCH="1"
# Off-cap strict-JSON repair of malformed tool arguments (recommended):
# AGENT_TOOLS_REPAIR="1"
# Skip the MCP source entirely (avoids spawning the stdio MCP server):
# RECOURSE_MCP_DISABLED="1"
# Override the MCP launcher (default: node node_modules/tsx/dist/cli.mjs mcp-server.ts):
# RECOURSE_MCP_COMMAND=""
# RECOURSE_MCP_ARGS="[]"
# RECOURSE_MCP_TIMEOUT_MS="15000"
# Multiple MCP servers (namespaced mcp_<serverId>__<tool>). When set this
# replaces the single built-in server, so include the Recourse one explicitly:
# RECOURSE_MCP_SERVERS='[{"id":"recourse","command":"node","args":["node_modules/tsx/dist/cli.mjs","mcp-server.ts"]},{"id":"files","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","C:\\data"]}]'
#
# Tool sources beyond MCP/skills, always on:
#   route_*       live REST operations from the OpenAPI index (33 ops today;
#                 extend buildOpenApiSpec in src/lib/openapi.ts for more)
#   federation_*  signed peer skills from the skill registry
# Mutating tools (selfhosted_*, skills_run, mutating route_*/mcp_*) are refused
# unless the caller presents RECOURSE_API_SECRET on POST /api/recourse/agent/tools.
#
# On-disk skill libraries (Draymond agents/skills, ECC) exposed as skills_list /
# skills_read / skills_file / skills_run. Scripts run in the skill dir with a
# timeout and output caps (no shell). Set AGENT_SKILLS_EXEC="0" to make
# skills_run refuse and keep the skills surface read-only.
# AGENT_SKILLS_EXEC="1"
# AGENT_SKILLS_TIMEOUT_MS="60000"
# Python interpreter for .py skill scripts (default: python):
# RECOURSE_PYTHON=""
# Override the scanned skill libraries entirely (JSON array of {id, root}).
# When unset, the built-in multi-library default list is used (fleet-skills,
# ECC, hermes, deterministic-brain, paperclip, deepseek-harness, omnigent,
# browser-use, axiom, ownmem, opencode, supabase).
# RECOURSE_SKILL_ROOTS='[{"id":"fleet-skills","root":"C:\\path\\to\\skills"}]'
#
# Autonomous skill use (dream, forge, mutator, evolve, math, biotech, synergy
# loops): Recourse searches the catalog for relevant skills, injects them, and
# lets the model call the skills tools where it is safe.
# AGENT_SKILLS_AUTONOMY="1"            # 0 = disable skill awareness for autonomy
# AGENT_SKILLS_AUTONOMY_TOOLS="1"      # 0 = inject only, no tool loop
# AGENT_SKILLS_AUTONOMY_JSON_TOOLS="1" # 0 = never tool-loop strict-JSON tasks
# AGENT_SKILLS_AUTONOMY_TURNS="3"
# AGENT_SKILLS_AUTONOMY_MAX_SKILLS="3"
# Max SKILL.md characters inlined for the single best match (metadata only for
# the rest; full body is available on demand via skills_read):
# AGENT_SKILLS_BODY_CHARS="2500"
# 1 = LLM-rerank the candidate skills before injecting (adds one model call):
# AGENT_SKILLS_RERANK="0"

# API embedding (vector memory). EMBEDDING_MODEL must be set to enable API
# embeddings; otherwise the honest lexical-hash embedder is used:
# EMBEDDING_BASE_URL=""
# EMBEDDING_MODEL=""

# Context window kept small to bound KV cache on CPU. Raise for big codegen.
MODEL_NUM_CTX="4096"
# Set to "1" to allow Qwen-style thinking/reasoning tokens (slower, costlier).
MODEL_THINKING="0"

# Deterministic (non-AI) mutation candidates are produced when the model is
# offline. They are always labeled "deterministic_fallback" - never presented
# as AI output. Set to "0" to disable the fallback entirely.
ALLOW_DETERMINISTIC_FALLBACK="1"

# GitHub Research tab (real GitHub REST API). Optional token raises rate
# limits (unauthenticated: 10 repo-searches/min, 60 core requests/hr).
GITHUB_TOKEN=""

# Optional Supabase for durable learner state (otherwise a local JSON file,
# recourse_learner.json, is used).
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""

# Tiered memory (episodic + semantic). Durable by default via SQLite
# (better-sqlite3, WAL). The store survives restarts and resumes ids; semantic
# consolidation is idempotent (a cluster already represented is never re-emitted).
# Set MEMORY_IN_MEMORY=1 for a hermetic, non-persistent store (tests already do).
# MEMORY_DB="data/memory.sqlite"           # override the DB path
# MEMORY_IN_MEMORY="0"
# MEMORY_CONSOLIDATION_MS="900000"         # episodic -> semantic cadence (15 min)
# Promoted skills (skill auto-promotion pass) are written here as SKILL.md folders:
# RECOURSE_SKILLS_DIR="data/skills"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Capability Forge (closed autonomous self-improvement loop).
# The forge can run on a DIFFERENT (typically faster/local) model than the rest
# of the app. Fallback chain: FORGE_* -> API_MODEL_* -> MODEL_* -> the API
# default. Point FORGE_MODEL_BASE_URL at a loopback endpoint to use the local
# profile, or at any OpenAI-compatible URL to use the API profile.
# FORGE_MODEL_BASE_URL="http://127.0.0.1:11434/v1"
# FORGE_MODEL_NAME="minicpm5-2b"
# FORGE_MODEL_API_KEY="local"
# FORGE_MODEL_TIMEOUT_MS="240000"

# Stuck-aware self-repair loop (self-awareness + repair-team escalation).
# Every SELF_REPAIR_MS the dev autopilot watches real signals (scheduler job
# failures, self-hosted boot re-verify failures, forge quarantine, open
# anomalies, verifier pass-rate, repair-team reachability, failure-ledger
# spikes). When a subsystem fails past its threshold it is marked "stuck" and
# Recourse: (1) reports it to the Draymond repair team (score >= band), (2) asks
# the deterministic brain for a targeted fix, and (3) applies only proposals
# that pass the same sandbox verifier + lint gate as every other fleet patch.
# RECOURSE_SELF_REPAIR_MS="300000"          # detector cadence (default 5 min)
# RECOURSE_SELF_REPAIR_BACKOFF_MS="600000"  # per-issue escalation backoff (default 10 min)
# RECOURSE_SELF_REPAIR_APPLY="1"            # 0 => still dispatch+ask brain, never auto-apply
# RECOURSE_SELF_REPAIR_BAND="50"            # repair-team auto-dispatch band floor
# Service remediation (self-repair -> policy -> approval -> deploy actuator).
# A JSON map from a service-kind stuck issue id to the docker-compose service to
# restart/redeploy. Only ids present here are ever acted on; nothing is guessed.
# The action is policy-gated: an `allow` rule runs it, `require_approval` queues
# a human approval (see /api/recourse/ops/approvals), `deny` refuses. The deploy
# actuator shell commands run only when RECOURSE_SELF_REPAIR_APPLY != 0.
# RECOURSE_REMEDIATE_SERVICES='{"oncology:host":"overlay-oncology","job:keywire":"keywire"}'

# Self-hosted tool capability sandbox (QuickJS/WASM). Self-hosted tools execute
# in a real sandbox by default; host capabilities are default-deny and every
# check is recorded. SELFHOST_SANDBOX controls the path:
#   "auto"   (default) prefer the sandbox, fall back to the direct import ONLY
#            when the sandbox is unavailable or cannot represent the tool
#   "sandbox" always sandbox (hard fail if unavailable)
#   "direct"  legacy direct import (full server privileges)
# A grant denial or a tool error never falls back — only genuine
# unavailability/setup limits do, and responses carry the mode that ran.
# Requires the quickjs-emscripten dependency (an optional install).
# SELFHOST_SANDBOX="auto"
# Per-execution wall-clock budget for guest code, in milliseconds.
# SELFHOST_SANDBOX_TIMEOUT_MS="5000"
# On-disk root the sandbox fs grant (and driver) is confined to.
# SELFHOST_SANDBOX_FS_ROOT=".selfhosted/sandbox-fs"

# RECOURSE_REPO="C:\path\to\recourse"                # repo root patches may touch (default: cwd)
# RECOURSE_REPO_URL=""                                  # repo_url sent to the repair team
# AUDIT_URLS: RepoRank=3200 Grader=3201 Codegang=3204 BRAIN=3210 DEV_BRAIN=3450
# REPORANK_URL="http://localhost:3200"   GRADER_URL="http://localhost:3201"
# CODEGANG_URL="http://localhost:3204"
# The Deep (deterministic brain, POST /task): BRAIN_URL="http://localhost:3210"
# Genome-council (Recourse -> brain /genome-council/*): /api/recourse/develop/council*
#   Deterministic brain also supplies Kaggle datasets + news to Recourse intake
#   when enabled (BRAIN_URL must be set). They drop into the normal signal store.
# RECOURSE_INTAKE_BRAIN_KAGGLE_QUERIES="cancer drug resistance,protein structure,differential privacy"
# RECOURSE_INTAKE_BRAIN_NEWS="1"          # pull brain /news on each intake poll
# RECOURSE_INTAKE_BRAIN_NEWS_LIMIT="10"   # max news items per poll
# Dev-Brain (weighted decide / repair-triage / fusion): DEV_BRAIN_URL="http://localhost:3450"
# Axiom OS (deterministic agent loop, verified-patch intake): AXIOM_URL="http://localhost:3198"
# # Ingest-forward routes (RepoRank/Grader/Codegang). Their remote audit schemas
# # are not locally validated, so dossier forwarding is only enabled when set:
# REPORANK_INGEST_PATH=""  GRADER_INGEST_PATH=""  CODEGANG_INGEST_PATH=""
# Repair team dispatch (Draymond ops + Benchmark Olympics):
# DRAYMOND_URL="http://localhost:3000"
# DRAYMOND_CRON_SECRET=""                 # Bearer secret for /api/ops/repair-benchmark
# DRAYMOND_REPAIR_BENCHMARK_ENABLED="1"   # 0 => proposal-only (never auto-fix)

# AgentBrowser web channel (download/fetch from the web through the real browser).
# Set AGENTBROWSER_API_KEY to AgentBrowser's AGENT_API_KEY. Routes:
#   GET  /api/recourse/web/agentbrowser   (status)
#   POST /api/recourse/web/download       {url, mode: download|reader|extract|search, selectors?}
# AGENTBROWSER_URL="http://localhost:3700"
# AGENTBROWSER_API_KEY=""
# Web pages to download every intake poll through AgentBrowser (comma-separated
# public http(s) URLs). Each becomes a grounding signal for the forge:
# AGENTBROWSER_POLL_URLS=""

# Python NetworkX Knowledge-Graph sidecar (real graph analytics over the
# oncology KG: centrality / neighborhoods / bridges-to-proven-hubs). The
# sidecar is stateless compute - Recourse sends the graph each call, it never
# owns a copy. Run it from python/kg_service:
#   pip install -r python/kg_service/requirements.txt
#   uvicorn main:app --host 127.0.0.1 --port 8500
# When the sidecar is down, /api/recourse/kg/sidecar reports online:false and
# the analysis routes return ok:false (never a fabricated metric).
KG_SIDECAR_URL="http://127.0.0.1:8500"

# Live oncology evidence layer (Phase 1): Open Targets Platform (GraphQL) and
# PubTator 3.0 (REST) — no keys required. Providers are probed independently and
# a down provider contributes nothing (never a fabricated score/edge).
# OPEN_TARGETS_URL="https://api.platform.opentargets.org/api/v4/graphql"
# PUBTATOR_URL="https://www.ncbi.nlm.nih.gov/research/pubtator3-api"
# Live evidence file cache (shared by both providers):
# LIVE_EVIDENCE_CACHE_DIR="data"
# LIVE_EVIDENCE_CACHE_TTL_MS="21600000"
# Oncology disease ids (MONDO/EFO) for the live graph (comma-separated):
# LIVE_ONCOLOGY_DISEASES="MONDO_0005575,MONDO_0005233,MONDO_0007254,MONDO_0005105,MONDO_0005192,MONDO_0018177"
# PubTator search topics for co-occurrence edges (comma-separated):
# LIVE_ONCOLOGY_TOPICS="KRAS resistance cancer,PD-1 PD-L1 checkpoint resistance,tumor microenvironment immunotherapy,EGFR mutation targeted therapy,HER2 breast cancer"
# LIVE_KG_MAX_TARGETS_PER_DISEASE="10"
# LIVE_KG_MAX_ARTICLES="4"

# Python PDF sidecar (PyMuPDF real text extraction over a paper URL or bytes).
# Stateless compute - Recourse sends the PDF, gets text back. Full-text papers
# feed the intake/corpus pipeline and address the "KG can't read clinical
# papers" gap. Honest: a scanned/image-only PDF reports scanned_only_image_pdf,
# never invented text. Run it from python/pdf_service:
#   pip install -r python/pdf_service/requirements.txt
#   uvicorn main:app --host 127.0.0.1 --port 8600
PDF_SIDECAR_URL="http://127.0.0.1:8600"

# Python fuzzy sidecar (RapidFuzz near-duplicate detection). Stateless - send a
# needle + candidates (or a name list) for real scores. This is the dedup layer
# for registry tool names / GitHub UNVERIFIED candidates / learner genes, where
# exact matching misses near-duplicates. Run it from python/fuzz_service:
#   pip install -r python/fuzz_service/requirements.txt
#   uvicorn main:app --host 127.0.0.1 --port 8700
FUZZ_SIDECAR_URL="http://127.0.0.1:8700"

# Python transcription sidecar (faster-whisper: audio/video -> text). Stateless;
# when the ASR backend is missing it returns ok:false, never invented text.
#   pip install -r python/transcribe_service/requirements.txt
#   uvicorn main:app --host 127.0.0.1 --port 8900
TRANSCRIBE_SIDECAR_URL="http://127.0.0.1:8900"
# WHISPER_MODEL="base"     # model size the sidecar loads

# Python voice-clone sidecar (zero-shot TTS: text + a reference clip -> speech in
# that voice). Stateless; when no zero-shot backend (coqui-tts/XTTS-v2 or
# f5-tts) is installed it returns ok:false, never a different voice passed off as
# a clone. Backs the VOICE CLONE tab and cloned narration in src/lib/voice.ts.
#   pip install -r python/tts_service/requirements.txt
#   uvicorn main:app --host 127.0.0.1 --port 8910
TTS_SIDECAR_URL="http://127.0.0.1:8910"
# TTS_LANGUAGE="en"        # default language code for synthesis
# TTS_DEVICE="cpu"         # torch device for XTTS ("cuda" if available)
# XTTS_MODEL="tts_models/multilingual/multi-dataset/xtts_v2"

# Environment telemetry cadence (machine load + git state sensor, ms).
# TELEMETRY_MS="60000"

# Distributed tracing (W3C trace context + OTLP/HTTP JSON export). Spans are
# always buffered in-process (GET /api/recourse/ops/traces); when an OTLP
# endpoint is set, POST /api/recourse/ops/traces/export ships them to a
# collector. With no endpoint, export reports "disabled" (never faked).
# OTEL_EXPORTER_OTLP_ENDPOINT="http://127.0.0.1:4318"
# OTEL_SERVICE_NAME="recourse"
# Telemetry reads (/metrics and the ops trace/policy/approval views) are open on
# the local bind by default. Set RECOURSE_TELEMETRY_AUTH=1 to require the mutation
# secret on them (they expose model names/costs and request paths).
# RECOURSE_TELEMETRY_AUTH="0"

# Budgeted action wallet (durable hash-chained spend ledger). The sandbox
# `spend` grant is debited against a token balance; auto-merge requires a funded
# `merge` budget. Set budgets via POST /api/recourse/wallet/budget (guarded).
# WALLET_LEDGER_FILE="data/wallet-ledger.jsonl"
# RECOURSE_MERGE_BUDGET_TOKEN="merge"
# RECOURSE_MERGE_RESERVE_CENTS="0"     # reserve required before auto-merge

# Python BioSim sidecar (Monte Carlo tumor/CAR-T + sequencing detection).
#   pip install -r python/biosim_service/requirements.txt
#   uvicorn main:app --host 127.0.0.1 --port 8503
# When down, /api/recourse/biosim/* report ok:false (never fabricated).
BIOSIM_SIDECAR_URL="http://127.0.0.1:8503"

# Python Data Visualizer sidecar (curated subset of the
# Data_Visualization-main repo rendered as PNG artifacts).
#   pip install -r python/viz_service/requirements.txt
#   uvicorn main:app --host 127.0.0.1 --port 8505
# When down, /api/recourse/viz/* report ok:false (never fabricated).
VIZ_SIDECAR_URL="http://127.0.0.1:8505"

# Overlay Science bridges (all fail-soft: ok:false when the service is down).
# Overlay Oncology Next app (pm2 "overlay-oncology") — ACTUALLY RUNS ON :3070.
# (Port 3000 is Keywire's SPA; pointing ONCOLOGY_URL there yields HTML, not
# JSON.) The aggregate bridge reaches Decon/QLCCE/ATTEC/ctDNA/Oncograph/
# HelixForge/daraxonrasib through this host's routes (predict, simulate,
# discovery/*, evidence, research/*, validation/*, calibration/*,
# mechanism-fusion) — see docs/oncology-integration-plan.md.
ONCOLOGY_URL="http://127.0.0.1:3070"
# Biotech scientific API (DNA/protein/gene/stats workbench).
SCIENTIFIC_API_URL="http://127.0.0.1:8090"
# Biotech research-integrity service (reproducibility/custody wrapper).
INTEGRITY_URL="http://127.0.0.1:8025"
# Fleet research-orchestrator (study planning + runs/claims ledger).
ORCHESTRATOR_URL="http://127.0.0.1:8099"
# Prometheus discovery engine export API.
PROMETHEUS_URL="http://127.0.0.1:3001"

# BioSim-Fusion protein folding API (quantum/classical/hybrid).
#   cd to biosim_fusion && python -m biosim_fusion.api.main (port 8000)
FOLDING_URL="http://127.0.0.1:8000"
# UMOE mechanistic oncology engine (stdlib HTTP service).
#   python -m umoe.service --port 8723 (from components/UMOE)
UMOE_URL="http://127.0.0.1:8723"
# Overlay-Chemlab cheminformatics + kinetics API (Express).
#   node server.js (PORT env; defaults 3000 — set CHEMLAB_URL if moved)
CHEMLAB_URL="http://127.0.0.1:3000"
# OncoForesight relapse/resistance/toxicity predictors (Next app).
#   bun dev -p <port> (defaults 3000 — set ONCOFORESIGHT_URL if moved)
ONCOFORESIGHT_URL="http://127.0.0.1:3000"
# Pathosphere is off-chain validated in-process (no RPC needed).
# On-chain execution requires hardhat deployment with a funded key:
# BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"

# Python trend engine sidecar (statsmodels STL + ruptures PELT changepoints).
#   pip install -r python/trend_service/requirements.txt
#   uvicorn main:app --host 127.0.0.1 --port 8800
# When down, the trend phase falls back to the pure-TS engine (engine: 'ts')
# and the sidecar routes report ok:false (never fabricated).
TREND_SIDECAR_URL="http://127.0.0.1:8800"

# HTTP hardening (helmet + rate limiting).
# - helmet headers are always on; the full Content-Security-Policy is applied in
#   production (NODE_ENV=production) and relaxed in dev so Vite HMR works.
# - Rate limit over /api/: generous by default so Recourse's in-process loops
#   are never throttled (they call engines directly, not self-HTTP). Set
#   RECOURSE_RATE_LIMIT_MAX=0 to disable, or tune window/limit for your exposure.
# RECOURSE_RATE_LIMIT_WINDOW_MS="60000"
# RECOURSE_RATE_LIMIT_MAX="1000"

# Axiom Agent Harness (autonomous project loop + self-iterated tool builds)
AXIOM_URL="http://127.0.0.1:3198"
AXIOM_TIMEOUT_MS="180000"
# Auth for outbound Axiom calls: Axiom gates /api/*. Set AXIOM_API_TOKEN to a
# pre-minted JWT, or leave empty to mint one from the Keywire jwtSecret in
# KEYWIRE_KEYS_FILE / AXIOM_KEYS_FILE. With neither, calls are unauthenticated.
# AXIOM_API_TOKEN=""
# AXIOM_KEYS_FILE="C:/Users/User/Downloads/Uplift/Keywire/data/keywire-keys.json"

# Mutation secret for Recourse's OWN guarded routes (fleet-memory intake, MCP
# writes, patch revert...). Fail-closed when unset. Axiom/OpenHub set the same
# value so their outcome write-backs are accepted.
# RECOURSE_API_SECRET=""

# hackingtool security bridge (Z4nzu/hackingtool, MIT) — AUTHORIZED testing only.
# Read-only catalog awareness + goal->tool recommendations work with just a
# hackingtool checkout + PyYAML (no CLI, no installs, no execution). Abusive
# goals (flooding/DoS/jamming, malware/RAT/botnet, mass-targeting, credential
# stuffing, mass phishing) are refused before any call.
# HACKINGTOOL_DIR="C:/Users/User/Downloads/hackingtool"
# HACKINGTOOL_PYTHON="python"
# HACKINGTOOL_RUNNER="./python/hackingtool_runner.py"
# The ONE executing path (a headless engagement) is DISABLED by default. To arm
# it you must set HACKINGTOOL_ENGAGE_ENABLED=1, a HACKINGTOOL_SCOPE_ALLOWLIST,
# and RECOURSE_API_SECRET (the route is fail-closed). Targets must match the
# allowlist and the pipeline must be allow-listed, or the run is refused.
# Requires the hackingtool CLI (Linux/macOS only).
# HACKINGTOOL_ENGAGE_ENABLED="0"
# HACKINGTOOL_SCOPE_ALLOWLIST="example.com,*.example.org"
# HACKINGTOOL_ALLOWED_PIPELINES="recon"
# HACKINGTOOL_BIN=""

# Keywire zero-trust vault + ecosystem command plane (fleet services).
# Recourse calls /api/v1/ecosystem/* to bring services up, probe Axiom, and
# read the fleet summary. When Keywire is down the routes report ok:false
# (never fabricated). KEYWIRE_SERVICE_TOKEN is used by src/autopilot/keywireClient
# to fetch GitHub tokens at PR-create time.
KEYWIRE_URL="http://127.0.0.1:3000"
# KEYWIRE_SERVICE_TOKEN=""

# Science conductor: when Axiom is reachable, the cycle materializes a
# self-hosted tool from the current hypothesis (build -> sandbox -> self-host).
# Set SCIENCE_AXIOM_BUILD=0 to skip real Axiom builds (CI/fast tests).
# SCIENCE_AXIOM_BUILD="1"
# Set SCIENCE_KEYWIRE_HANDOFF=0 to skip the per-cycle Keywire fleet handoff
# (service bring-up + brain task) in CI/fast tests.
# SCIENCE_KEYWIRE_HANDOFF="1"

# Research reports + issue progression (scheduler jobs).
# REPORT_MS controls the fleet-report cadence (default 6h); KEYWIRE_POLL_MS
# controls the Keywire fleet-poll cadence (default 5min).
# REPORT_MS="21600000"
# KEYWIRE_POLL_MS="300000"

# Self Reporter — Recourse writes a deterministic, first-person field dispatch
# about its own systems/development/connections/growth/data. The article is a
# pure function of live state (same state => same words, content-addressed by
# the SHA-256 of its facts); a new dispatch is only written when that
# fingerprint changes. REPORTER_MS controls the cadence (default 2h).
# REPORTER_DIR overrides the archive directory (default data/reports/reporter).
# Optional model narration is attached separately and is NON-CANONICAL: it never
# changes the article body or its fingerprint, and stays unavailable when the
# model is offline. Routes: /api/recourse/reporter/{status,latest,articles,
# article/:fingerprint,generate,narrate}. OpenHub proxies these under
# /api/recourse/reporter/*.
# REPORTER_MS="7200000"
# REPORTER_DIR="data/reports/reporter"
# REPORTER_SOUL_FILE overrides the reporter's voice (see
# reporter.soul.yaml.example). It controls identity/mission/anti-goals and the
# communication register; absent files are ignored.
# REPORTER_SOUL_FILE="reporter.soul.yaml"
# REPORTER_MC_TRIALS sets the seeded Monte Carlo trial count (default 512). The
# draws are seeded from the article's facts, so the same state reproduces the
# same distribution — deterministic uncertainty, not randomness. Each dispatch
# also carries a deterministic anti-slop prose audit (sloptrim-style patterns).
# REPORTER_MC_TRIALS="512"

# Overlay Global Lens — direct research-publish connection. Recourse composes
# dated research briefs from REAL state (science findings + ResearchArtifacts,
# trend ledger, ecosystem corpus: bbtech/hempforge/ECOS/sports/golf/oncology)
# and POSTs them to Global Lens POST /api/publish (idempotent sha256 dedupe).
# Fail-closed: without GL_PUBLISH_KEY the pass reports ok:false and never claims
# a publish. GL_PUBLISH_KEY must match the value configured in Global Lens.
# GLOBAL_LENS_URL="http://127.0.0.1:3090"
# GL_PUBLISH_KEY=""
# GLOBAL_LENS_PUBLISH_MS="21600000"

# Translation engines (BB-Tech basketball→biotech, golf-surgery). Recourse runs
# the REAL sibling-repo Python engines as stateless subprocesses via
# python/translation_runner.py. Override paths only if the repos live elsewhere.
# TRANSLATION_PYTHON="python"
# TRANSLATION_RUNNER="./python/translation_runner.py"
# BBTECH_ENGINE_FILE="C:\Users\User\Downloads\Uplift\02_Pillars\Overlay Science\Shared\bb_tech_core\translation_engine.py"
# GOLF_ENGINE_FILE="C:\Users\User\Downloads\Uplift\02_Pillars\Overlay Science\Shared\golf_surgery_core\golf_surgery_translation_engine.py"

# ---------------------------------------------------------------------------
# Wave 1 — commercial layer: metering, identity, quotas, billing.
# ---------------------------------------------------------------------------
# Usage meter: durable JSONL ledger of model/tool/request usage with real token
# counts and computed cost (cents). Model calls are metered via the model-usage
# sink and the `model` wallet budget is debited when the rounded cost >= 1c.
# RECOURSE_USAGE_LEDGER_FILE="data/usage-ledger.jsonl"
# Per-model price table (cents per million tokens). Merges over the built-ins:
# RECOURSE_MODEL_PRICES_JSON='{"my-model":{"inputCentsPerMTok":14,"outputCentsPerMTok":28}}'
# Budget token debited for model spend:
# RECOURSE_MODEL_BUDGET_TOKEN="model"
# Tenant attributed to in-process (non-API) model usage:
# RECOURSE_SYSTEM_TENANT="system"

# Tenants + API keys (durable JSON). Keys are `rck_<id>_<secret>`; only the
# SHA-256 hash is stored. Scopes: read | write | admin | billing.
# RECOURSE_TENANTS_FILE="data/auth/tenants.json"
# RECOURSE_APIKEYS_FILE="data/auth/apikeys.json"

# Pricing catalogue (JSON files under this directory; shipped: free/pro/scale).
# RECOURSE_PLANS_DIR="data/plans"

# Outcome feedback ledger — real scorecard/revenue deltas mapped to a reward in
# [0,1] and folded into the learner's external score by the server tick.
# RECOURSE_OUTCOME_LEDGER_FILE="data/outcome-feedback.json"

# Stripe billing (checkout + signature-verified webhooks). Unset => checkout
# reports 503 and the webhook fails closed (never a fabricated payment).
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_API_BASE="https://api.stripe.com/v1"
# Public base URL used for checkout success/cancel URLs:
# RECOURSE_PUBLIC_URL=""

# Bootstrap the commercial control plane (operator, guarded by
# RECOURSE_API_SECRET):
#   POST /api/recourse/commerce/tenants        {name, planId}
#   POST /api/recourse/commerce/keys           {tenantId, name, scopes}
#   GET  /api/recourse/commerce/usage?tenantId=&period=current|previous|YYYY-MM
#   GET  /api/recourse/commerce/plans
# The customer-facing surface is /v1 (API key in `x-api-key`; OpenAPI at
# GET /v1/openapi.json; typed client in src/lib/v1Client.generated.ts).

# ---------------------------------------------------------------------------
# Wave 4 — network effects: instance federation, public publishing + paywall,
# and growth channels (CRM / compliant outbound / SEO / ads / lead capture).
# ---------------------------------------------------------------------------
# --- Instance federation (signed peer-to-peer protocol) --------------------
# An Ed25519 identity is created on first boot and persists here. The private
# key is SECRET and never returned by any route.
# RECOURSE_FEDERATION_IDENTITY_FILE="data/federation/identity.json"
# RECOURSE_FEDERATION_PEERS_FILE="data/federation/peers.json"
# Inbound signed-envelope endpoint path (peers POST here) and outbound timeout:
# RECOURSE_FEDERATION_INBOX_PATH="/api/recourse/federation/inbox"
# RECOURSE_FEDERATION_TIMEOUT_MS="8000"
# Add a peer (guarded by RECOURSE_API_SECRET), then trust it:
#   POST /api/recourse/federation/peers           {url, publicKey, name, trust?}
#   POST /api/recourse/federation/peers/:id/trust {trust: trusted|pending|blocked}
#   POST /api/recourse/federation/peers/:id/ping|handshake|pull|push
# Peers are default-UNTRUSTED; only a trusted peer may pull or push bundles.

# --- Public publishing + paywall -------------------------------------------
# Articles are drafts until published; publish passes deliver to enabled targets
# (file / webhook / global_lens) and are idempotent per content hash.
# RECOURSE_PUBLISH_DIR="data/publishing/articles"
# RECOURSE_PUBLISH_TARGETS_FILE="data/publishing/targets.json"
# RECOURSE_PUBLISH_DELIVERIES_FILE="data/publishing/deliveries.jsonl"
# RECOURSE_PUBLISH_OUT_DIR="data/publishing/out"
# Reader access tokens (HMAC) for subscriber articles. Falls back to
# RECOURSE_API_SECRET when unset; with neither, the paywall fails closed.
# RECOURSE_PUBLISH_ACCESS_SECRET=""
# Routes: GET /api/recourse/publishing/articles[/:slug], POST /subscribe,
# POST /access/claim {sessionId} (verifies a paid Stripe checkout), and guarded
# operator writes (POST /articles, /articles/:slug/publish, /targets).

# --- Growth channels -------------------------------------------------------
# CRM contacts (durable, consent-recorded) and the suppression list.
# RECOURSE_CRM_FILE="data/growth/crm.json"
# RECOURSE_SUPPRESSION_FILE="data/growth/suppression.json"
# Outbound: signed one-click unsubscribe + a hard daily cap. Sending is DRY-RUN
# unless a provider is configured (none by default); dry-run queues to the
# outbox and reports zero sent.
# RECOURSE_UNSUBSCRIBE_SECRET=""          # falls back to RECOURSE_API_SECRET
# RECOURSE_OUTBOUND_DAILY_LIMIT="200"
# RECOURSE_OUTBOX_FILE="data/growth/outbox.jsonl"
# Routes: public POST /api/recourse/growth/leads (consent required, honeypot),
# POST/GET /outbound/unsubscribe?token=, and guarded CRM/outbound/SEO/ads.

# ---------------------------------------------------------------------------
# Wave 5 — verified self-modification + nightly autonomy.
# ---------------------------------------------------------------------------
# Self-modification policy (src/lib/selfModification.ts): a patch to Recourse's
# OWN source is classified as safety (never automatic: gate, policy, approvals,
# CI, secrets, lockfile), harness (needs approval), or auto (docs/data). With
# RECOURSE_SELF_MOD_APPLY=1 harness targets become unattended (still verified).
# Without it, each harness target needs an operator approval:
#   GET  /api/recourse/self-improvement/status
#   POST /api/recourse/self-improvement/classify     {file}
#   GET  /api/recourse/self-improvement/approvals
#   POST /api/recourse/self-improvement/approvals/:id/decide {status,decidedBy}
# RECOURSE_SELF_MOD_APPLY="0"

# CI-green harness gate for self-patches (runs BEFORE any write). The composite
# checks default to typecheck + lint; add test for the full CI bar. Requires the
# gate to be enabled (off by default so day-to-day dev is never slowed):
# RECOURSE_HARNESS_CI_GATE="0"
# RECOURSE_HARNESS_GATE_CHECKS="typecheck,lint"     # e.g. add ",test"
# RECOURSE_HARNESS_GATE_TIMEOUT_MS="600000"

# Nightly self-improvement coordinator (dream -> forge -> benchmark delta ->
# self-attested upgrade report). Runs at most once per UTC day unless forced.
#   POST /api/recourse/self-improvement/run          {force?}
#   GET  /api/recourse/self-improvement/report[?format=md]
# MCP tools: recourse.nightly_report, recourse.self_mod_status.
# RECOURSE_NIGHTLY_FILE="data/self-improvement/nightly.json"
# Approval queue + policy engine (Wave 2) live here:
# RECOURSE_APPROVALS_FILE="data/approvals.json"








